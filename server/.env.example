NODE_ENV=development
PORT=3333

DATABASE_URL=postgresql://docker:docker@localhost:5433/reloadcars

# Gere com: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333

# Origens confiáveis para login: painel web e esquema do app mobile
WEB_ORIGIN=http://localhost:3000
MOBILE_SCHEME=reloadcars://

# Mapbox (rotas e busca de endereços): https://account.mapbox.com/access-tokens
MAPBOX_ACCESS_TOKEN=

# Open Charge Map (importação de pontos públicos): https://openchargemap.org/site/develop/api
OCM_API_KEY=
