{
  "openapi": "3.0.3",
  "info": {
    "title": "ReloadCars API",
    "description": "API do app de pontos de recarga para veículos elétricos.",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Perfil do usuário logado (RF03)",
        "tags": [
          "profile"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string",
                      "format": "email",
                      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "driver",
                        "admin"
                      ]
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "email",
                    "role",
                    "createdAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/charge-points/nearby": {
      "get": {
        "operationId": "getNearbyChargePoints",
        "summary": "Pontos de recarga próximos, do mais perto ao mais longe (RF08)",
        "tags": [
          "charge-points"
        ],
        "parameters": [
          {
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "in": "query",
            "name": "lat",
            "required": true
          },
          {
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "in": "query",
            "name": "lng",
            "required": true
          },
          {
            "schema": {
              "default": 10,
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": true,
              "maximum": 50
            },
            "in": "query",
            "name": "radiusKm",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "chargePoints": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "source": {
                            "type": "string",
                            "enum": [
                              "partner",
                              "ocm"
                            ]
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "nullable": true,
                            "type": "string"
                          },
                          "address": {
                            "nullable": true,
                            "type": "string"
                          },
                          "latitude": {
                            "type": "number"
                          },
                          "longitude": {
                            "type": "number"
                          },
                          "powerKw": {
                            "nullable": true,
                            "type": "number"
                          },
                          "pricePerKwhCents": {
                            "nullable": true,
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "connectors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "openingHours": {
                            "nullable": true,
                            "type": "string"
                          },
                          "attribution": {
                            "nullable": true,
                            "type": "string"
                          },
                          "partnerName": {
                            "nullable": true,
                            "type": "string"
                          },
                          "distanceMeters": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "id",
                          "source",
                          "name",
                          "description",
                          "address",
                          "latitude",
                          "longitude",
                          "powerKw",
                          "pricePerKwhCents",
                          "connectors",
                          "openingHours",
                          "attribution",
                          "partnerName",
                          "distanceMeters"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "chargePoints"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/charge-points/{id}": {
      "get": {
        "operationId": "getChargePoint",
        "summary": "Detalhes de um ponto de recarga",
        "tags": [
          "charge-points"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "partner",
                        "ocm"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "nullable": true,
                      "type": "string"
                    },
                    "address": {
                      "nullable": true,
                      "type": "string"
                    },
                    "latitude": {
                      "type": "number"
                    },
                    "longitude": {
                      "type": "number"
                    },
                    "powerKw": {
                      "nullable": true,
                      "type": "number"
                    },
                    "pricePerKwhCents": {
                      "nullable": true,
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "connectors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "openingHours": {
                      "nullable": true,
                      "type": "string"
                    },
                    "attribution": {
                      "nullable": true,
                      "type": "string"
                    },
                    "partnerName": {
                      "nullable": true,
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "source",
                    "name",
                    "description",
                    "address",
                    "latitude",
                    "longitude",
                    "powerKw",
                    "pricePerKwhCents",
                    "connectors",
                    "openingHours",
                    "attribution",
                    "partnerName"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/directions": {
      "get": {
        "operationId": "getDirections",
        "summary": "Rota de carro entre dois pontos (RF09)",
        "tags": [
          "directions"
        ],
        "parameters": [
          {
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "in": "query",
            "name": "fromLat",
            "required": true
          },
          {
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "in": "query",
            "name": "fromLng",
            "required": true
          },
          {
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "in": "query",
            "name": "toLat",
            "required": true
          },
          {
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "in": "query",
            "name": "toLng",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "distanceMeters": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "durationSeconds": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "coordinates": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "latitude": {
                            "type": "number"
                          },
                          "longitude": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "latitude",
                          "longitude"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "distanceMeters",
                    "durationSeconds",
                    "coordinates"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "502": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
