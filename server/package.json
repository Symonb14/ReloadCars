{
  "name": "@reloadcars/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "typecheck": "tsc",
    "lint": "biome check",
    "format": "biome check --write",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env -- drizzle-kit studio",
    "auth:generate": "dotenv -e .env -- auth generate --config src/auth.ts --output src/db/schema/auth.ts --yes",
    "create-admin": "node --env-file=.env src/scripts/create-admin.ts",
    "pretest": "dotenv -e .env.test -- drizzle-kit migrate",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "db:seed": "node --env-file=.env src/db/seed.ts",
    "import:ocm": "node --env-file=.env src/scripts/import-ocm.ts",
    "openapi": "node --env-file=.env src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.5",
    "@fastify/cors": "11.3.0",
    "@fastify/swagger": "9.9.0",
    "@scalar/fastify-api-reference": "1.71.0",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "auth": "1.7.5",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
